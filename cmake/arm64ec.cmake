# ARM64EC cross build with llvm-mingw. Override LLVM_MINGW_ROOT if the
# toolchain lives elsewhere.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR ARM64EC)
if(NOT LLVM_MINGW_ROOT)
  if(DEFINED ENV{LLVM_MINGW_ROOT})
    set(LLVM_MINGW_ROOT "$ENV{LLVM_MINGW_ROOT}")
  else()
    set(LLVM_MINGW_ROOT "$ENV{HOME}/llvm-mingw-ec")
  endif()
endif()
set(_triple arm64ec-w64-mingw32)
set(CMAKE_C_COMPILER "${LLVM_MINGW_ROOT}/bin/${_triple}-clang")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW_ROOT}/bin/${_triple}-clang++")
set(CMAKE_RC_COMPILER "${LLVM_MINGW_ROOT}/bin/${_triple}-windres")
set(CMAKE_AR "${LLVM_MINGW_ROOT}/bin/${_triple}-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${LLVM_MINGW_ROOT}/bin/${_triple}-ranlib" CACHE FILEPATH "")
set(CMAKE_DLLTOOL "${LLVM_MINGW_ROOT}/bin/${_triple}-dlltool" CACHE FILEPATH "")
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW_ROOT}/aarch64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
